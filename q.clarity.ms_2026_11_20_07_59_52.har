":"13545446098999601624"},{"name":"eo-cache-status","value":"MISS"}],"content":{"size":1513,"mimeType":"application/json","text":"{\"msg\":\"success\",\"code\":200,\"data\":{\"affiche\":{\"unreadMessageSize\":1,\"unreadMessageList\":[{\"vcMessageCreateTime\":\"2026-11-20 10:25:26\",\"vcMessageType\":1,\"vcNoticeId\":223,\"vcMessageId\":60475609,\"vcMessageStatus\":0,\"vcMessageUserId\":8538329,\"vcMessageContext\":\"尊敬的用户，您好！\\n\\n为提升设备运行稳定性，我们计划在 11 月 19 日凌晨 03:00（UTC+8） 起分批对设备进行镜像升级，预计耗时 2 小时\\n\\n升级过程中，涉及升级的设备将重启，设备使用可能短暂中断。请您提前保存重要数据，并妥善安排正在运行的任务。\\n\\n给您带来的不便，敬请谅解。感谢您的理解与配合！\\n\\nDear users,\\n\\nTo improve device stability, we will roll out a system image upgrade in batches starting at 03:00 on November 19 (UTC+8). The rollout is expected to take approximately two hours.\\n\\nAffected devices will restart during the upgrade and may be briefly unavailable. Please save any important data in advance and plan accordingly for any tasks running on your devices.\\n\\nWe apologize for any inconvenience and appreciate your understanding and cooperation.\"}]},\"agent\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]},\"transfer\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]},\"automation\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]},\"create\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]},\"authProxy\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]},\"repayment\":{\"unreadMessageSize\":0,\"unreadMessageList\":[]}},\"ts\":1795141698012}"},"redirectURL":"","headersSize":582,"bodySize":911,"_status":"completed","_startTimestamp":1795141697937736,"_endTimestamp":1795141697961619},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"43.174.196.248","connection":"9","comment":"","_id":281,"_uid":"69c14e13-11bd-4a6c-a332-3488d9fe20ce","_cid":9,"_ctime":1795141618077,"_sid":265,"_stime":1795141697557,"_serverAddress":"43.174.196.248","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_cli